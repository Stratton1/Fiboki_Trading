# Merged .gitignore: V1 (now under legacy/v1/) + V2 (repository root).
# Both trees' ignores apply everywhere, because both trees now live in one
# repository and share one working directory.

# Worktrees
.worktrees/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
dist/
build/
*.egg-info/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Node
node_modules/
.next/
.vercel/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets
.env
.env.local
.env.production
!legacy/v1/frontend/.env.production
*.key
*.pem

# Data (keep fixtures and starter).
# data/ is ~10 GB of market data shared by both trees. Everything bulk is
# ignored; the small committed fixtures and the starter parquet set are not.
data/raw/*
data/cleaned/*
data/canonical/
data/live/
data/features/
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/starter/

# V2 research artefacts
research/experiments/*.db

# Playwright
.playwright-mcp/
legacy/v1/frontend/test-results/
legacy/v1/frontend/playwright-report/
legacy/v1/frontend/screenshots/
test-results/
playwright-report/

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite3
fiboki_backup_*.sql

# debug probe debris (never commit)
_*.db
_*.db*
_*.db-journal
*.db-journal
_*probe*
