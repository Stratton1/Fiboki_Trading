# Fiboki V2 systemd unit: Fiboki executable-price recorder (OANDA practice top of book, read only).
#
# TEMPLATE. Do not copy by hand: scripts/server-install.sh substitutes
# __FIBOKI_ROOT__, __FIBOKI_USER__, __FIBOKI_GROUP__, __FIBOKI_LIB__ and
# __FIBOKI_ENV_FILE__ and writes /etc/systemd/system/fiboki-quotes.service.
#
# * Runs scripts/fiboki-service.sh quotes, which reads the env file, forces
#   FIBOKI_EXECUTION_MODE=paper and unsets every live control. No live control and
#   no credential is set anywhere in this file; secrets live in __FIBOKI_ENV_FILE__
#   (mode 600, owned by the service user, never in the repository).
# * Needs FIBOKI_OANDA_PRACTICE_TOKEN and FIBOKI_OANDA_PRACTICE_ACCOUNT_ID in the env file. OPT-IN: not started by
#   default (scripts/server-install.sh --services ...,quotes).
# * Memory: MemoryMax=384M (small budget); the whole group is also capped by fiboki.slice.

[Unit]
Description=Fiboki executable-price recorder (OANDA practice top of book, read only)
Documentation=file://__FIBOKI_ROOT__/docs/v2/SERVER.md
After=network-online.target
Wants=network-online.target
# Do not thrash on a poisoned state: five starts in ten minutes, then stay failed
# (and the heartbeat timer tells you).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=__FIBOKI_USER__
Group=__FIBOKI_GROUP__
Slice=fiboki.slice
WorkingDirectory=__FIBOKI_ROOT__

Environment=FIBOKI_EXECUTION_MODE=paper
Environment=HOME=__FIBOKI_LIB__
Environment=FIBOKI_HOME=__FIBOKI_LIB__/.fiboki
Environment=FIBOKI_STATE_DIR=__FIBOKI_LIB__/var
Environment=FIBOKI_ENV_FILE=__FIBOKI_ENV_FILE__
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/bin/bash __FIBOKI_ROOT__/scripts/fiboki-service.sh quotes

# Graceful shutdown: SIGTERM, then SIGKILL after TimeoutStopSec. Keep it above
# WorkerConfig.shutdown_grace_seconds (30 s) or systemd kills a worker that is
# shutting down correctly (deploy/README.md, Shutdown timing).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

Restart=on-failure
RestartSec=15
# Exit 75 is a held lease or an operator-only divergence: restarting is pointless.
SuccessExitStatus=75

Nice=0
OOMScoreAdjust=-200
MemoryHigh=320M
MemoryMax=384M
TasksMax=512
LimitNOFILE=8192

# Hardening. The service sees the system read-only; its only writable place is
# the state directory (datastore, ledgers, journals, logs, quotes, leases).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__FIBOKI_LIB__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fiboki-quotes

[Install]
WantedBy=multi-user.target
