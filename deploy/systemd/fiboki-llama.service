# Fiboki V2 systemd unit: Fiboki local model server (llama.cpp, CPU, 127.0.0.1:8080) for the research agents. OPTIONAL.
#
# TEMPLATE. Do not copy by hand: scripts/server-install.sh substitutes
# __FIBOKI_ROOT__, __FIBOKI_USER__, __FIBOKI_GROUP__, __FIBOKI_LIB__ and
# __FIBOKI_ENV_FILE__ and writes /etc/systemd/system/fiboki-llama.service.
#
# * Runs scripts/fiboki-service.sh llama, which reads the env file, forces
#   FIBOKI_EXECUTION_MODE=paper and unsets every live control. No live control and
#   no credential is set anywhere in this file; secrets live in __FIBOKI_ENV_FILE__
#   (mode 600, owned by the service user, never in the repository).
# * OPTIONAL and only on a box with RAM to spare (16 GB: the 9B Q4_K_M tier). Never downloads weights:
#   scripts/llama-server.sh prints the pinned download. LLAMA_SERVER_ARGS in the env file selects the tier.
# * Memory: MemoryMax=8G (large budget); the whole group is also capped by fiboki.slice.

[Unit]
Description=Fiboki local model server (llama.cpp, CPU, 127.0.0.1:8080) for the research agents. OPTIONAL
Documentation=file://__FIBOKI_ROOT__/docs/v2/SERVER.md
After=network-online.target
Wants=network-online.target
# Do not thrash on a poisoned state: five starts in ten minutes, then stay failed
# (and the heartbeat timer tells you).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=__FIBOKI_USER__
Group=__FIBOKI_GROUP__
Slice=fiboki.slice
WorkingDirectory=__FIBOKI_ROOT__

Environment=FIBOKI_EXECUTION_MODE=paper
Environment=HOME=__FIBOKI_LIB__
Environment=FIBOKI_HOME=__FIBOKI_LIB__/.fiboki
Environment=FIBOKI_STATE_DIR=__FIBOKI_LIB__/var
Environment=FIBOKI_ENV_FILE=__FIBOKI_ENV_FILE__
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/bin/bash __FIBOKI_ROOT__/scripts/fiboki-service.sh llama

# Graceful shutdown: SIGTERM, then SIGKILL after TimeoutStopSec. Keep it above
# WorkerConfig.shutdown_grace_seconds (30 s) or systemd kills a worker that is
# shutting down correctly (deploy/README.md, Shutdown timing).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

Restart=on-failure
RestartSec=15
# Exit 75 is a held lease or an operator-only divergence: restarting is pointless.
SuccessExitStatus=75

Nice=5
OOMScoreAdjust=500
CPUQuota=400%
CPUWeight=50
MemoryHigh=7G
MemoryMax=8G
TasksMax=512
LimitNOFILE=8192

# Hardening. The service sees the system read-only; its only writable place is
# the state directory (datastore, ledgers, journals, logs, quotes, leases).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__FIBOKI_LIB__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fiboki-llama

[Install]
WantedBy=multi-user.target
