<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fiboki V2 desktop service: the research worker (a separate process, never a thread in the API).

  TEMPLATE. Do not copy by hand: scripts/launchd-install.sh substitutes
  __FIBOKI_ROOT__ (the repository) and writes the result to
  ~/Library/LaunchAgents/uk.fiboki.worker.plist.

  * Runs scripts/fiboki-service.sh worker, which reads ~/.fiboki/env, forces
    FIBOKI_EXECUTION_MODE=paper and unsets every live control. No live
    control is set anywhere in this file.
  * A LaunchAgent: it runs as the operator and stops at logout.
  * KeepAlive restarts a crash (non-zero exit) but not a clean exit;
    ThrottleInterval turns a crash loop into a slow retry.
  * Logs go to var/logs/ inside the repository.
  * ExitTimeOut (45 s) exceeds WorkerConfig.shutdown_grace_seconds (30 s), so
    launchd does not SIGKILL a worker that is shutting down cleanly. Exit 75
    (another holder has the lease) is not a success and is retried slowly.
  * Supersedes deploy/launchd/com.fiboki.research-worker.plist. Do not load
    both; `fiboki doctor` warns if you do.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uk.fiboki.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__FIBOKI_ROOT__/scripts/fiboki-service.sh</string>
        <string>worker</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__FIBOKI_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FIBOKI_EXECUTION_MODE</key>
        <string>paper</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>ExitTimeOut</key>
    <integer>45</integer>

    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__FIBOKI_ROOT__/var/logs/worker.log</string>
    <key>StandardErrorPath</key>
    <string>__FIBOKI_ROOT__/var/logs/worker.err.log</string>
</dict>
</plist>
